# 统一换行符：仓库内一律 LF，Windows 专有脚本检出为 CRLF
* text=auto eol=lf

# Windows 平台必须有 CRLF（cmd.exe 对纯 LF 的 .bat 多行处理会出错）
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# 源码 / 文档 / 配置：LF
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制：不做任何换行处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
