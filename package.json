{
  "name": "steam-lighthouse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Steam 灯塔 —— 随机盲盒发现冷门佳作 + 多游戏加权相似度检索",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
